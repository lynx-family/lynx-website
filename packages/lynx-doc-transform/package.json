{
  "name": "@lynx-js/lynx-doc-transform",
  "version": "0.1.0",
  "description": "Shared Markdown parsing and build transforms for Lynx documentation.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./parser": {
      "types": "./src/parser.d.mts",
      "import": "./src/parser.mjs"
    },
    "./rsbuild": {
      "types": "./src/rsbuild.d.mts",
      "import": "./src/rsbuild.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pack:check": "node scripts/check-pack.mjs",
    "test": "node --test tests/parser.test.mjs tests/version-bindings.test.mjs tests/rsbuild.test.mjs",
    "test:integration": "node --test tests/version-bindings.integration.test.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/estree": "^1.0.8",
    "@types/mdast": "^4.0.4",
    "gray-matter": "^4.0.3",
    "magic-string": "^0.30.21",
    "mdast-util-mdx": "3.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.3",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rsbuild/core": "2.3.3",
    "@rspress/core": "2.1.5",
    "@types/node": "^18.11.17",
    "parse5": "^7.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.3.3"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
