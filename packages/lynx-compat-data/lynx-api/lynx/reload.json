{
  "lynx-api": {
    "lynx": {
      "reload": {
        "__compat": {
          "description": "Reloads the current page, like the Refresh button.",
          "lynx_path": "api/lynx-api/lynx/lynx-reload",
          "spec_url": [],
          "status": {
            "deprecated": false,
            "experimental": false
          },
          "support": {
            "android": {
              "version_added": "2.7",
              "partial_implementation": true,
              "notes": "ReactLynx 3.0 is not supported."
            },
            "ios": {
              "version_added": "2.7",
              "partial_implementation": true,
              "notes": "ReactLynx 3.0 is not supported."
            },
            "harmony": {
              "version_added": "3.4",
              "partial_implementation": true,
              "notes": "ReactLynx 3.0 is not supported."
            },
            "clay_macos": {
              "version_added": "3.5"
            },
            "clay_windows": {
              "version_added": "3.5"
            },
            "web_lynx": {
              "version_added": true,
              "partial_implementation": true,
              "notes": "Reloads the `<lynx-view>` (`LynxView.reload()` re-renders the card), but the `value` (new init data) and `callback` parameters are both ignored — the card reloads with whatever `initData`/attributes are already on the element, and no completion callback is invoked. Implemented since `@lynx-js/web-core@0.19.6` (lynx-family/lynx-stack#2127)."
            }
          }
        }
      }
    }
  }
}
