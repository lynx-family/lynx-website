{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "platformAutomerge": false,
  "pruneStaleBranches": true,
  "timezone": "Asia/Shanghai",
  "schedule": ["every weekend"],
  "updateNotScheduled": false,
  "prHourlyLimit": 5,
  "commitHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "addLabels": ["bot:renovate"],
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "matchPackageNames": ["@lynx-example/*", "@lynxtron-examples/*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["*"],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": ["prettier", "prettier-plugin-packagejson"],
      "rangeStrategy": "pin"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["@types/node"],
      "branchTopic": "types-node-{{{newMajor}}}.x"
    },
    {
      "matchPackageNames": ["@lynx-js/**"],
      "minimumReleaseAge": "0 days",
      "prPriority": 80
    },
    {
      "matchPackageNames": ["@lynx-js/css-defines"],
      "schedule": ["at any time"],
      "prPriority": 90,
      "prHourlyLimit": 0,
      "commitHourlyLimit": 0,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0
    },
    {
      "matchPackageNames": [
        "@lynx-js/lynx-stack-docs",
        "@lynx-js/lynx-stack-docs-canary"
      ],
      "schedule": ["at any time"],
      "prPriority": 100,
      "prHourlyLimit": 0,
      "commitHourlyLimit": 0,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0
    },
    {
      "matchPackageNames": ["tailwindcss"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "groupName": "Rspress",
      "groupSlug": "rspress",
      "matchPackageNames": ["/^@rspress\\//", "/^@shikijs\\//"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "matchPackageNames": ["/^@rspress\\//", "/^@shikijs\\//"],
      "rangeStrategy": "pin"
    },
    {
      "groupName": "Rsbuild plugins",
      "groupSlug": "rsbuild-plugins",
      "matchPackageNames": [
        "@rsbuild/plugin-less",
        "@rsbuild/plugin-sass",
        "@rsbuild/plugin-svgr"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "groupName": "Rsbuild plugins (major)",
      "groupSlug": "rsbuild-plugins-major",
      "matchPackageNames": [
        "@rsbuild/plugin-less",
        "@rsbuild/plugin-sass",
        "@rsbuild/plugin-svgr"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "Semi UI",
      "groupSlug": "semi-ui",
      "matchPackageNames": ["@douyinfe/semi-ui", "@douyinfe/semi-icons"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "groupName": "MDX and Remark",
      "groupSlug": "mdx-remark",
      "matchPackageNames": [
        "@mdx-js/mdx",
        "@mdx-js/react",
        "remark-cjk-friendly",
        "remark-cjk-friendly-gfm-strikethrough",
        "remark-gfm",
        "unist-util-visit"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
