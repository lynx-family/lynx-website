{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableRateLimiting"],
  "semanticCommits": "enabled",
  "automerge": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "rangeStrategy": "bump"
    }
  ]
}
