{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "automerge": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": ["@lynx-js/lynx-stack-docs-canary"],
      "followTag": "latest"
    }
  ]
}
