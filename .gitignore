# Local
.DS_Store
*.local
*.log*
!*.log*.mdx
**/__pycache__/
*.py[cod]

# Dist
node_modules
dist/
doc_build/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OpenCode
.omo/
.idea

scripts/*.json

.history

docs/public/lynx-compat-data
docs/public/lynx-examples

# Build-time OG images (regenerated by `pnpm gen:og`; vendored fonts/logos
# under scripts/og/ stay committed).
docs/public/og/

.lynx-ui-source/

# Final documentation ownership published after prepare for downstream callers.
scripts/alias-contracts/documentation-corpus.json

lynx-examples/

# Generated files (regenerated on pnpm install via prepare hook)
packages/lynx-compat-data/css/properties/*.json
packages/lynx-compat-data/api-stats.json
# The sections of @lynx-js/lynx-stack-docs, as its manifest.json lists them.
docs/*/api/build/
docs/*/api/react/
docs/*/api/genui/
docs/*/api/packages/

# Mounted from @lynx-js/skills-docs. AI navigation is composed from templates.
docs/*/ai/agent-lynx/
docs/*/ai/skills/
docs/*/ai/_meta.json
docs/_ai/
docs/public/ai/agent-lynx/
docs/public/ai/skills/

# Element compat source indexes are regenerated on demand by tooling.
packages/lynx-compat-data/.generated/

!*logger.md
.reference/
.trae/
context/
